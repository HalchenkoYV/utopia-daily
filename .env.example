# Copy this file to .env.local and fill in real values.
# Never commit .env.local. In Vercel, add the same names under Project Settings -> Environment Variables.

# Supabase -> Project Settings -> API (Data API): Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase -> Project Settings -> API Keys: the "Publishable" key (or the legacy "anon public" key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — never expose to the browser
GEMINI_API_KEY=
